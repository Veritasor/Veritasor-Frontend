# Copy this file to .env and adjust values as needed.
# All variables are optional; do not commit real secrets.

# Base URL for backend API requests (used when connecting to a live backend)
VITE_API_URL=http://localhost:3000

# Use mock API adapters instead of live backend requests (set to false for live API)
VITE_USE_MOCKS=true

# Session timeout duration in minutes (default: 30)
VITE_SESSION_DURATION_MINUTES=30

# Minutes before session expiry to display the warning dialog (default: 5)
VITE_SESSION_WARNING_BEFORE_MINUTES=5
